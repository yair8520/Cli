{
  "name": "rn-gen",
  "version": "1.0.0",
  "description": "React Native component generator CLI",
  "main": "dist/index.js",
  "bin": {
    "rn-gen": "dist/index.js"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "inquirer": "^9.2.15"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.7",
    "@types/node": "^20.11.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "keywords": ["react-native", "cli", "generator", "component", "scaffold"],
  "author": "yair8520",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yair8520/Cli.git"
  },
  "homepage": "https://github.com/yair8520/Cli#readme",
  "bugs": {
    "url": "https://github.com/yair8520/Cli/issues"
  }
